# Chave da API do Claude (console.anthropic.com > API Keys). Cobrada à parte do plano Pro.
ANTHROPIC_API_KEY=

# WhatsApp Cloud API (developers.facebook.com > seu app > WhatsApp > Configuração da API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Senha que você inventa e digita também no painel da Meta ao cadastrar o webhook
WHATSAPP_VERIFY_TOKEN=
# Chave secreta do app (Configurações do app > Básico > Chave secreta do app)
WHATSAPP_APP_SECRET=
# Versão da Graph API (opcional)
GRAPH_API_VERSION=v23.0

# Números que podem falar com os assessores, com DDI e DDD, separados por vírgula
# Ex.: 5511999998888,5521988887777
ALLOWED_NUMBERS=

# Postgres (Neon, pela integração da Vercel). Opcional na fase 0: sem ele o Diretor
# responde, mas não guarda histórico.
DATABASE_URL=
